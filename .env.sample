# Celery broker: the catalog's Redis (dev: db 7 through the k8s-bridge). REDIS_URL works too.
BROKER=redis://localhost:6379/7
OCR_QUEUE=evilflowers_ocr_worker

# Shared data volume; task `source`, `destination` and `outcome` are relative to it.
STORAGE_PATH=/mnt/data

# Engines: default when the task names none, and which ones a caller may pick.
OCR_DEFAULT_ENGINE=tesseract
OCR_ENABLED_ENGINES=["tesseract","rapidocr"]
# Pages OCR'd in parallel; equal to the pod's CPU limit.
OCR_JOBS=1

# Standalone hOCR for the books digitalizer (issue #7): a second Deployment of this image sets
# BROKER=redis://…/8 and OCR_QUEUE=evilflowers_ocr_worker.standalone (or ….standalone.interactive).
# RapidOCR downscales a leaf whose longer side exceeds this many pixels.
RAPIDOCR_MAX_SIDE_LEN=2000

# Suspicious OCR lines (issue #8): on in the standalone task, off in files.ocr (it OCRs every page twice).
STANDALONE_LINE_CHECK=true
OCR_LINE_CHECK=false
LINE_CHECK_CONFIDENCE=80
LINE_CHECK_MAX_EDIT_RATIO=0.15
LINE_CHECK_MAX_LINES=40
HUNSPELL_DICTIONARIES={"slk":"sk_SK","ces":"cs_CZ","eng":"en_US"}
# The decider judge of disputed lines (evilflowers-worker judges); off unless both are set.
# JUDGES_ENABLED=true
# DECIDER_URL=http://decider.shared.svc.cluster.local
# JUDGE_THRESHOLDS={"ocr_line_reading": {"keep": 0.9, "hide": 0.9}}

# Scale-in (evilflowers-worker's shutdown): grace, then cold cancel; together under the pod's 30 s.
WORKER_SOFT_SHUTDOWN_TIMEOUT=10
WORKER_CANCEL_TIMEOUT=10
# Deliveries of one message before a PDF that kills the worker is given up `failed`.
MAX_DELIVERIES=5

LOG_LEVEL=INFO
# json (Loki) or text (terminal)
LOG_FORMAT=text

# Telemetry: off unless an endpoint (or HOST_IP) is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ocr
