# Celery broker: the catalog's Redis (dev: db 7 through the k8s-bridge). REDIS_URL works too.
BROKER=redis://localhost:6379/7
OCR_QUEUE=evilflowers_ocr_worker

# Shared data volume; task `source` / `destination` are relative to it.
STORAGE_PATH=/mnt/data

# API key of the catalog service user with `tasks.report_job`.
CATALOG_API_KEY=

# Engines: default when the task names none, and which ones a caller may pick.
OCR_DEFAULT_ENGINE=tesseract
OCR_ENABLED_ENGINES=["tesseract","rapidocr"]
# Pages OCR'd in parallel; equal to the pod's CPU limit.
OCR_JOBS=1

LOG_LEVEL=INFO
# json (Loki) or text (terminal)
LOG_FORMAT=text

# Telemetry: off unless an endpoint (or HOST_IP) is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ocr
